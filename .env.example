# Firebase config lives in src/firebase.js (Firebase web keys are public IDs,
# secured by Firestore Security Rules + App Check — not secrets).
#
# --- App Check (required if enforcement is ON for AI Logic / Firestore) ---
# reCAPTCHA v3 site key from Firebase console → App Check → register this web app.
VITE_RECAPTCHA_SITE_KEY=
# Optional: pin a localhost App Check debug token instead of the auto-generated
# one printed to the browser console (register it under App Check → debug tokens).
# VITE_APPCHECK_DEBUG_TOKEN=
#
# The AI settings below are OPTIONAL overrides; sensible defaults apply if unset.
# VITE_GEMINI_MODEL=gemini-2.5-flash
# VITE_GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# VITE_GEMINI_THINKING_BUDGET=0
# VITE_LLM_MAX_TOKENS=8192
# VITE_LLM_TEMPERATURE=0.2
# VITE_LLM_MAX_REPAIRS=2
# VITE_INTEGRITY_SKILLS_POLICY=grounded
