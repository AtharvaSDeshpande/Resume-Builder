rules_version = '2';

// Per-user resume access. A signed-in user can only read, create, update or
// delete resume documents that carry their own uid — so nobody can ever see
// another user's resumes. Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /resumes/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid)
                    && isOwner(request.resource.data.uid);
    }

    // Job positions (company, JD, interview date, status, tailored résumé +
    // saved feedback). Scoped to the owner, same as résumés.
    match /jobPositions/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid)
                    && isOwner(request.resource.data.uid);
    }

    // Admin-managed per-user limits: readable by the owner, writable only from
    // the Firestore console / Admin SDK (never by the client).
    match /userLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // BYOK secrets: each user's own Gemini API key, encrypted (AES-256-GCM)
    // before storage. Accessed ONLY via the Admin SDK on the server — the client
    // can never read or write it, so the (already encrypted) secret is never
    // exposed to any browser.
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // Daily usage counters. Now written ONLY by the server (Admin SDK, which
    // bypasses these rules), so the client can never tamper with its own quota.
    // The owner may read their usage; no client may write it.
    match /usage/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
