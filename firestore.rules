rules_version = '2';

// Per-user resume access. A signed-in user can only read, create, update or
// delete resume documents that carry their own uid — so nobody can ever see
// another user's resumes. Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A user's per-day AI-tailor allowance. Default is 1 (see below); create a
    // userLimits/{uid} doc with { dailyTailorLimit: N } in the console to raise
    // it for specific users. Users may read their limit but never change it.
    function dailyLimit(uid) {
      return exists(/databases/$(database)/documents/userLimits/$(uid))
        ? get(/databases/$(database)/documents/userLimits/$(uid)).data.dailyTailorLimit
        : 1;
    }

    match /resumes/{docId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid)
                    && isOwner(request.resource.data.uid);
    }

    // Admin-managed per-user limits: readable by the owner, writable only from
    // the Firestore console / Admin SDK (never by the client).
    match /userLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Daily usage counter. The client may only write its own doc, and the
    // stored count can never exceed that user's daily limit — so the quota
    // cannot be tampered above the allowance.
    match /usage/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0
                   && request.resource.data.count <= dailyLimit(uid);
    }
  }
}
