# ---- Backend (Node + Express résumé-tailoring agent) ----
PORT=8788
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase project (verifies client ID tokens; matches src/firebase.js).
FIREBASE_PROJECT_ID=resume-builder-501811
# Path to a service-account JSON to enable AIRTIGHT server-side quota (Admin
# Firestore). Without it, auth still works but the daily limit is not enforced.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Dev-only: bypass Firebase auth to iterate on the agent.
AUTH_DISABLED=false

# ---- BYOK (bring your own key) ----
# There is NO server-held Gemini key. Each user pastes their own key in-app; it
# is encrypted (AES-256-GCM) with this master key before being stored. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOK_ENC_KEY=your-32-byte-hex-or-base64-master-key

# ---- Gemini models (NAMES only, no keys) ----
# Tried best-first per request; a Pro model is used when the user's key can
# access it, else it falls back to Flash. Cheap models run the parse/critique.
GEMINI_PREFERRED_MODELS=gemini-2.5-pro,gemini-flash-latest,gemini-flash-lite-latest
GEMINI_PARSE_MODEL=gemini-flash-lite-latest
GEMINI_CRITIQUE_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_THINKING_BUDGET=0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=16384

# ---- Agent behaviour ----
AGENT_MAX_IMPROVES=2
AGENT_TARGET_SCORE=85
INTEGRITY_SKILLS_POLICY=grounded
